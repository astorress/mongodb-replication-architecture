="870" y="352" /><mxPoint x="870" y="216" /></Array></mxGeometry></mxCell><mxCell id="replication-24" edge="1" parent="replication-flow" source="replication-5" target="replication-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="380" /><mxPoint x="890" y="486" /></Array></mxGeometry></mxCell><mxCell id="replication-25" edge="1" parent="replication-flow" source="replication-7" target="replication-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;startArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="replication-init" parent="replication-0" value="replication-init" /><mxCell id="replication-26" parent="replication-init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Container &lt;b&gt;MongoReplicaInit&lt;/b&gt;&lt;br&gt;(se ejecuta una vez)" vertex="1"><mxGeometry x="190" y="640" width="300" height="180" as="geometry" /></mxCell><mxCell id="replication-27" parent="replication-init" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="196" y="644" width="24" height="24" as="geometry" /></mxCell><mxCell id="replication-28" parent="replication-init" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.gear;fontFamily=Verdana;" value="init.sh" vertex="1"><mxGeometry x="316" y="720" width="47" height="47" as="geometry" /></mxCell><mxCell id="replication-29" parent="replication-init" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="366" y="690" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-30" edge="1" parent="replication-init" source="replication-28" target="replication-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="743" /></Array></mxGeometry></mxCell><mxCell id="replication-host" parent="replication-0" value="replication-host" /><mxCell id="replication-31" parent="replication-host" style="shape=mxgraph.veeam2.laptop;html=1;fillColor=#CCCCCC;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;" value="Host · Compass&lt;br&gt;localhost:27021-27023" vertex="1"><mxGeometry x="690" y="890" width="100" height="60" as="geometry" /></mxCell><mxCell id="replication-32" parent="replication-host" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt;" vertex="1"><mxGeometry x="795" y="860" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-33" edge="1" parent="replication-host" source="replication-31" target="replication-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=0.57;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="replication-34" edge="1" parent="replication-host" source="replication-31" target="replication-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="840" /><mxPoint x="1076" y="840" /></Array></mxGeometry></mxCell><mxCell id="replication-35" edge="1" parent="replication-host" source="replication-31" target="replication-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="920" /><mxPoint x="1280" y="140" /><mxPoint x="1076" y="140" /></Array></mxGeometry></mxCell><mxCell id="replication-info" parent="replication-0" value="replication-info" /><mxCell id="replication-36" parent="replication-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Replica set rs0&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Un &lt;b&gt;replica set&lt;/b&gt; es un grupo de procesos &lt;b&gt;mongod&lt;/b&gt; que guardan la misma copia de los datos. Aquí son tres nodos de MongoDB 8.2, cada uno en su contenedor y con su propio volumen. Uno es el PRIMARY y los otros dos son SECONDARY. El objetivo es la alta disponibilidad: si un nodo cae, los datos siguen ahí y la aplicación sigue funcionando.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Arranque&lt;/b&gt; (azul). Cuando los tres mongod pasan su healthcheck, &lt;b&gt;MongoReplicaInit&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt; se conecta directo a mongo1 y le indica quiénes son los miembros del set y su prioridad; luego espera a que se elija un PRIMARY. Si el set ya existía, no hace nada.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Uso&lt;/b&gt;. El &lt;b&gt;desarrollador&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; ejecuta las &lt;b&gt;lecciones&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt; o el &lt;b&gt;notebook sandbox&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; dentro de MongoReplicaLab (desde VS Code o desde JupyterLab en el puerto 8881). pymongo recibe la lista de nodos y el nombre del set, pregunta a cada uno su rol y envía todas las escrituras al PRIMARY, &lt;b&gt;mongo1&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;. Por defecto las lecturas también van al PRIMARY; con otra read preference pueden ir a un SECONDARY.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Replicación&lt;/b&gt; (flechas punteadas). Cada cambio que acepta mongo1 queda anotado en su &lt;b&gt;oplog&lt;/b&gt;, un registro ordenado de operaciones. &lt;b&gt;mongo2&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; y &lt;b&gt;mongo3&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt; leen ese oplog continuamente y aplican los mismos cambios, normalmente con milisegundos de diferencia. Un SECONDARY también puede copiar de otro SECONDARY que esté al día.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Confirmación de escrituras&lt;/b&gt;. Con write concern &lt;i&gt;majority&lt;/i&gt; (el valor por defecto), mongo1 responde a la aplicación solo cuando al menos un SECONDARY ya tiene el cambio: 2 de 3 nodos. Así la escritura no se pierde aunque el PRIMARY se caiga justo después.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Failover&lt;/b&gt;. Los nodos se envían latidos (heartbeats) cada 2 segundos (flecha entre los SECONDARY). Si dejan de ver al PRIMARY durante 10 segundos, mongo2 o mongo3 piden una elección. Gana el que tenga el oplog más actualizado y consiga la mayoría de votos (2 de 3). pymongo detecta el nuevo PRIMARY y reintenta la escritura pendiente. Cuando mongo1 vuelve, se pone al día con el oplog y, por tener prioridad 2, recupera el rol de PRIMARY. La lección 06 lo provoca pidiéndole al PRIMARY que renuncie; también se puede apagar su contenedor.&lt;/p&gt;&lt;p&gt;Desde la máquina anfitriona, &lt;b&gt;Compass&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt; se conecta a cada nodo por su puerto publicado (27021, 27022 y 27023) con directConnection: así se ve que solo el PRIMARY acepta escrituras y cómo cambian los roles durante un failover.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1340" y="40" width="660" height="600" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>
