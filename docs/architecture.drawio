mily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" value="&lt;b&gt;mongo3&lt;/b&gt; · MongoNode3&lt;br&gt;SECONDARY · priority 1&lt;br&gt;copia del oplog" vertex="1"><mxGeometry x="1040" y="450" width="72" height="72" as="geometry" /></mxCell><mxCell id="replication-10" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;" vertex="1"><mxGeometry x="1110" y="420" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-flow" parent="replication-0" value="replication-flow" /><mxCell id="replication-11" parent="replication-flow" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;fontFamily=Verdana;" value="Desarrollador" vertex="1"><mxGeometry x="40" y="321" width="60" height="60" as="geometry" /></mxCell><mxCell id="replication-12" parent="replication-flow" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="95" y="291" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-13" parent="replication-flow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Container &lt;b&gt;MongoReplicaLab&lt;/b&gt;&lt;br&gt;Python 3.13 · pymongo · mongosh · JupyterLab" vertex="1"><mxGeometry x="190" y="200" width="300" height="380" as="geometry" /></mxCell><mxCell id="replication-14" parent="replication-flow" style=