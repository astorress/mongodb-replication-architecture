y" /></mxCell><mxCell id="replication-8" parent="replication-common" style="shape=mxgraph.webicons.mongodb;gradientColor=#DFDEDE;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;aspect=fixed;strokeColor=none;" value="&lt;b&gt;mongo1&lt;/b&gt; · MongoNode1&lt;br&gt;PRIMARY · priority 2&lt;br&gt;lecturas y escrituras" vertex="1"><mxGeometry x="600" y="320" width="66" height="62" as="geometry" /></mxCell><mxCell id="replication-9" parent="replication-common" style="shape=mxgraph.webicons.mongodb;gradientColor=#DFDEDE;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;aspect=fixed;strokeColor=none;" value="&lt;b&gt;mongo2&lt;/b&gt; · MongoNode2&lt;br&gt;SECONDARY · priority 1&lt;br&gt;copia del oplog" vertex="1"><mxGeometry x="960" y="180" width="66" height="62" as="geometry" /></mxCell><mxCell id="replication-10" parent="replication-common" style="shape=mxgraph.webicons.mongodb;gradientColor=#DFDEDE;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;aspect=fixed;strokeColor=none;" value="&lt;b&gt;mongo3&lt;/b&gt; · MongoNode3&lt;br&gt;SECONDARY · priority 1&lt;br&gt;copia del oplog" vertex="1"><mxGeometry x="960" y="430" width="66" height="62" as="geometry" /></mxCell><mxCell id="replication-11" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;" vertex="1"><mxGeometry x="666" y="290" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-12" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;" vertex="1"><mxGeometry x="1026" y="150" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-13" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;" vertex="1"><mxGeometry x="1026" y="400" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-14" edge="1" parent="replication-flow" source="replication-2" target="replication-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="replication-15" edge="1" parent="replication-flow" source="replication-5" target="replication-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="replication-16" edge="1" parent="replication-flow" source="replication-8" target="replication-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="338.6" /><mxPoint x="820" y="211" /></Array></mxGeometry></mxCell><mxCell id="replication-17" edge="1" parent="replication-flow" source="replication-8" target="replication-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="363.4" /><mxPoint x="820" y="461" /></Array></mxGeometry></mxCell><mxCell id="replication-18" edge="1" parent="replication-flow" source="replication-9" target="replication-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;startArrow=classic;startFill=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="211" /><mxPoint x="1120" y="461" /></Array></mxGeometry></mxCell><mxCell id="replication-19" parent="replication-init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C86;dashed=1;verticalAlign=top;fontColor=#5A6C86;fontFamily=Verdana;fontSize=12;" value="Container &lt;b&gt;MongoReplicaInit&lt;/b&gt;&lt;br&gt;(se ejecuta una vez)" vertex="1"><mxGeometry x="745" y="620" width="190" height="150" as="geometry" /></mxCell><mxCell id="replication-20" parent="replication-init" style="sketch=0;html=1;fillColor=#232F3D;strokeColor=none;shape=mxgraph.aws4.gear;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;" value="init.sh" vertex="1"><mxGeometry x="816" y="680" width="47" height="47" as="geometry" /></mxCell><mxCell id="replication-21" parent="replication-init" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="917" y="590" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-22" edge="1" parent="replication-init" source="replication-20" target="replication-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.235;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="703.5" /></Array></mxGeometry></mxCell><mxCell id="replication-info" parent="replication-0" value="replication-info" /><mxCell id="replication-infobox" parent="replication-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Replica set rs0&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Un &lt;b&gt;replica set&lt;/b&gt; es un grupo de procesos &lt;b&gt;mongod&lt;/b&gt; que guardan la misma copia de los datos. Aquí son tres nodos de MongoDB 8.2, cada uno en su contenedor y con su propio volumen. Uno es el PRIMARY y los otros dos son SECONDARY. El objetivo es la alta disponibilidad: si un nodo cae, los datos siguen ahí y la aplicación sigue funcionando.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Arranque&lt;/b&gt; (azul). Cuando los tres mongod responden, &lt;b&gt;MongoReplicaInit&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt; le indica a mongo1 quiénes son los miembros del set y su prioridad, y espera a que se elija un PRIMARY. Si el set ya existía, no hace nada.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Uso&lt;/b&gt;. El &lt;b&gt;desarrollador&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; ejecuta las lecciones en &lt;b&gt;MongoReplicaLab&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;. pymongo recibe la lista de nodos y el nombre del set, pregunta a cada uno su rol y envía todas las escrituras al PRIMARY, &lt;b&gt;mongo1&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;. Por defecto las lecturas también van al PRIMARY; con otra read preference pueden ir a un SECONDARY.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Replicación&lt;/b&gt; (flechas punteadas). Cada cambio que acepta mongo1 &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; queda anotado en su &lt;b&gt;oplog&lt;/b&gt;, un registro ordenado de operaciones. &lt;b&gt;mongo2&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; y &lt;b&gt;mongo3&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; leen ese oplog continuamente y aplican los mismos cambios, normalmente con milisegundos de diferencia. Un SECONDARY también puede copiar de otro SECONDARY que esté al día.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Confirmación de escrituras&lt;/b&gt;. Con write concern &lt;i&gt;majority&lt;/i&gt; (el valor por defecto), mongo1 responde a la aplicación solo cuando al menos un SECONDARY ya tiene el cambio: 2 de 3 nodos. Así la escritura no se pierde aunque el PRIMARY se caiga justo después.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Failover&lt;/b&gt;. Los nodos se envían latidos (heartbeats) cada 2 segundos (flecha entre los SECONDARY). Si dejan de ver al PRIMARY durante 10 segundos, mongo2 &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; o mongo3 &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; piden una elección. Gana el que tenga el oplog más actualizado y consiga la mayoría de votos (2 de 3). pymongo detecta el nuevo PRIMARY y reintenta la escritura pendiente. Cuando mongo1 &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; vuelve, se pone al día con el oplog y, por tener prioridad 2, recupera el rol de PRIMARY.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1260" y="40" width="700" height="530" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>
