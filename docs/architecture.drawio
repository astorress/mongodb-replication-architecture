<diagram id="replication-page" name="Replica set"><mxGraphModel grid="0" page="1" background="#ffffff"><root><mxCell id="replication-0" /><mxCell id="replication-bg" parent="replication-0" value="background" /><mxCell id="replication-bgr" parent="replication-bg" style="whiteSpace=wrap;html=1;strokeColor=none;" value="" vertex="1"><mxGeometry width="2020" height="980" as="geometry" /></mxCell><mxCell id="replication-common" parent="replication-0" value="replication-common" /><mxCell id="replication-1" parent="replication-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Docker Compose · proyecto &lt;b&gt;mongodb-replication&lt;/b&gt; · red interna (cada servicio se resuelve por su nombre)" vertex="1"><mxGeometry x="160" y="40" width="1140" height="820" as="geometry" /></mxCell><mxCell id="replication-2" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="166" y="44" width="24" height="24" as="geometry" /></mxCell><mxCell id="replication-3" parent="replication-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Replica set &lt;b&gt;rs0&lt;/b&gt; · base &lt;i&gt;company&lt;/i&gt; · colección &lt;i&gt;employees&lt;/i&gt;" vertex="1"><mxGeometry x="600" y="100" width="660" height="480" as="geometry" /></mxCell><mxCell id="replication-4" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspe